# ── Helper Functions ──

static func get_total_quests() -> int:
	return CAREERS.size() * 5  # 27 careers * 5 quests = 135

static func get_career_count() -> int:
	return CAREERS.size()  # 27

static func get_career(career_id: String) -> Dictionary:
	return CAREERS.get(career_id, {})

static func get_career_name(career_id: String) -> String:
	var c = CAREERS.get(career_id, {})
	return c.get("name", career_id)

static func get_career_location(career_id: String) -> String:
	var c = CAREERS.get(career_id, {})
	return c.get("location", "")

static func get_career_skills(career_id: String) -> Array:
	var c = CAREERS.get(career_id, {})
	return c.get("skills", [])

static func get_quest_count(career_id: String) -> int:
	var c = CAREERS.get(career_id, {})
	return c.get("quests", []).size()

static func get_quest(career_id: String, quest_index: int) -> Dictionary:
	var c = CAREERS.get(career_id, {})
	var quests = c.get("quests", [])
	if quest_index < 0 or quest_index >= quests.size():
		return {}
	return quests[quest_index]

static func get_careers_by_location(location: String) -> Array:
	var result: Array = []
	for career_id in CAREERS:
		if CAREERS[career_id].get("location", "") == location:
			result.append(career_id)
	return result

static func get_all_career_ids() -> Array:
	return CAREERS.keys()

static func get_location_list() -> Array:
	var locs: Array = []
	for career_id in CAREERS:
		var loc = CAREERS[career_id].get("location", "")
		if not locs.has(loc):
			locs.append(loc)
	return locs
